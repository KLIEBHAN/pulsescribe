{
  "schema_version": 2,
  "app_states": [
    "idle",
    "loading",
    "listening",
    "recording",
    "transcribing",
    "refining",
    "done",
    "no_speech",
    "error"
  ],
  "daemon_error_codes": [
    "missing_api_key",
    "busy",
    "timeout",
    "invalid_provider",
    "input_monitoring",
    "accessibility_permission",
    "microphone_permission",
    "microphone_unavailable",
    "connection",
    "missing_dependency",
    "unknown"
  ],
  "parse_bool": [
    {
      "input": null,
      "expected": null
    },
    {
      "input": "",
      "expected": null
    },
    {
      "input": "   ",
      "expected": null
    },
    {
      "input": "1",
      "expected": true
    },
    {
      "input": "true",
      "expected": true
    },
    {
      "input": "TRUE",
      "expected": true
    },
    {
      "input": " yes ",
      "expected": true
    },
    {
      "input": "On",
      "expected": true
    },
    {
      "input": "0",
      "expected": false
    },
    {
      "input": "false",
      "expected": false
    },
    {
      "input": "FALSE",
      "expected": false
    },
    {
      "input": " no ",
      "expected": false
    },
    {
      "input": "Off",
      "expected": false
    },
    {
      "input": "maybe",
      "expected": null
    },
    {
      "input": "2",
      "expected": null
    }
  ],
  "parse_env_line": [
    {
      "input": "",
      "key": null,
      "value": null
    },
    {
      "input": "   # comment",
      "key": null,
      "value": null
    },
    {
      "input": "NO_EQUALS",
      "key": null,
      "value": null
    },
    {
      "input": "=missing_key",
      "key": null,
      "value": null
    },
    {
      "input": "KEY=value",
      "key": "KEY",
      "value": "value"
    },
    {
      "input": "KEY=",
      "key": "KEY",
      "value": ""
    },
    {
      "input": "  export MODE = local  ",
      "key": "MODE",
      "value": "local"
    },
    {
      "input": "export MODE = \"local\" # keep",
      "key": "MODE",
      "value": "local"
    },
    {
      "input": "export MODE = \"\" # keep",
      "key": "MODE",
      "value": ""
    },
    {
      "input": "MIC='Bob\\'s #1 \"USB\" \\\\Mic' # inline",
      "key": "MIC",
      "value": "Bob's #1 \"USB\" \\Mic"
    },
    {
      "input": "HASH_NO_SPACE=abc#def",
      "key": "HASH_NO_SPACE",
      "value": "abc#def"
    },
    {
      "input": "HASH_WITH_SPACE=abc # trailing comment",
      "key": "HASH_WITH_SPACE",
      "value": "abc"
    },
    {
      "input": "QUOTED_HASH=\"abc # kept\" # trailing",
      "key": "QUOTED_HASH",
      "value": "abc # kept"
    }
  ],
  "format_env_assignment": [
    {
      "key": "PULSESCRIBE_MODE",
      "value": "local",
      "expected": "PULSESCRIBE_MODE=local"
    },
    {
      "key": "PULSESCRIBE_MODE",
      "value": "",
      "expected": "PULSESCRIBE_MODE="
    },
    {
      "key": "PULSESCRIBE_INPUT_DEVICE",
      "value": "MacBook Pro Microphone",
      "expected": "PULSESCRIBE_INPUT_DEVICE=MacBook Pro Microphone"
    },
    {
      "key": "PULSESCRIBE_INPUT_DEVICE",
      "value": "Bob's #1 \"USB\" \\Mic",
      "expected": "PULSESCRIBE_INPUT_DEVICE='Bob\\'s #1 \"USB\" \\\\Mic'"
    }
  ],
  "env_updates": [
    {
      "name": "single-unchanged-preserves-format-and-dup",
      "lines": [
        "export MODE = \"local\" # keep",
        "MODE=legacy"
      ],
      "updates": [
        [
          "MODE",
          "local"
        ]
      ],
      "preserve_following_duplicates": true,
      "expected_lines": [
        "export MODE = \"local\" # keep",
        "MODE=legacy"
      ],
      "expected_changed": false
    },
    {
      "name": "batch-unchanged-canonicalizes-and-dedupes",
      "lines": [
        "export MODE = \"local\" # keep",
        "MODE=legacy"
      ],
      "updates": [
        [
          "MODE",
          "local"
        ]
      ],
      "preserve_following_duplicates": false,
      "expected_lines": [
        "MODE=local"
      ],
      "expected_changed": true
    },
    {
      "name": "single-changed-updates-first-keeps-dup",
      "lines": [
        "export MODE = \"old\"",
        "# keep",
        "MODE=legacy"
      ],
      "updates": [
        [
          "MODE",
          "local"
        ]
      ],
      "preserve_following_duplicates": true,
      "expected_lines": [
        "MODE=local",
        "# keep",
        "MODE=legacy"
      ],
      "expected_changed": true
    },
    {
      "name": "batch-changed-collapses-dup",
      "lines": [
        "export MODE = \"old\"",
        "# keep",
        "MODE=legacy"
      ],
      "updates": [
        [
          "MODE",
          "local"
        ]
      ],
      "preserve_following_duplicates": false,
      "expected_lines": [
        "MODE=local",
        "# keep"
      ],
      "expected_changed": true
    },
    {
      "name": "single-empty-value-not-deletion",
      "lines": [
        "MODE=old",
        "MODE=legacy"
      ],
      "updates": [
        [
          "MODE",
          ""
        ]
      ],
      "preserve_following_duplicates": true,
      "expected_lines": [
        "MODE=",
        "MODE=legacy"
      ],
      "expected_changed": true
    },
    {
      "name": "batch-deletion-removes-all-matching",
      "lines": [
        "# keep",
        "MODE=old",
        "MODE=legacy",
        "OTHER=first",
        "OTHER=second"
      ],
      "updates": [
        [
          "MODE",
          null
        ]
      ],
      "preserve_following_duplicates": false,
      "expected_lines": [
        "# keep",
        "OTHER=first",
        "OTHER=second"
      ],
      "expected_changed": true
    },
    {
      "name": "batch-absent-deletion-is-noop",
      "lines": [
        "# keep",
        "OTHER=first"
      ],
      "updates": [
        [
          "MODE",
          null
        ]
      ],
      "preserve_following_duplicates": false,
      "expected_lines": [
        "# keep",
        "OTHER=first"
      ],
      "expected_changed": false
    },
    {
      "name": "batch-append-empty-value",
      "lines": [
        "# keep",
        "OTHER=value"
      ],
      "updates": [
        [
          "MODE",
          ""
        ]
      ],
      "preserve_following_duplicates": false,
      "expected_lines": [
        "# keep",
        "OTHER=value",
        "MODE="
      ],
      "expected_changed": true
    },
    {
      "name": "batch-multi-key-order",
      "lines": [
        "PULSESCRIBE_HOTKEY=f18",
        "PULSESCRIBE_HOLD_HOTKEY=fn"
      ],
      "updates": [
        [
          "PULSESCRIBE_TOGGLE_HOTKEY",
          "f19"
        ],
        [
          "PULSESCRIBE_HOTKEY",
          null
        ],
        [
          "PULSESCRIBE_HOTKEY_MODE",
          null
        ]
      ],
      "preserve_following_duplicates": false,
      "expected_lines": [
        "PULSESCRIBE_HOLD_HOTKEY=fn",
        "PULSESCRIBE_TOGGLE_HOTKEY=f19"
      ],
      "expected_changed": true
    },
    {
      "name": "quoted-key-deletion",
      "lines": [
        "'OPENAI_API_KEY'=secret",
        "OTHER=1"
      ],
      "updates": [
        [
          "OPENAI_API_KEY",
          null
        ]
      ],
      "preserve_following_duplicates": false,
      "expected_lines": [
        "OTHER=1"
      ],
      "expected_changed": true
    },
    {
      "name": "quoted-key-replacement",
      "lines": [
        "'OPENAI_API_KEY'=old"
      ],
      "updates": [
        [
          "OPENAI_API_KEY",
          "new"
        ]
      ],
      "preserve_following_duplicates": false,
      "expected_lines": [
        "OPENAI_API_KEY=new"
      ],
      "expected_changed": true
    },
    {
      "name": "quoted-key-single-unchanged",
      "lines": [
        "'OPENAI_API_KEY'=same"
      ],
      "updates": [
        [
          "OPENAI_API_KEY",
          "same"
        ]
      ],
      "preserve_following_duplicates": true,
      "expected_lines": [
        "'OPENAI_API_KEY'=same"
      ],
      "expected_changed": false
    },
    {
      "name": "export-tab-key-replacement",
      "lines": [
        "export\tMODE=old"
      ],
      "updates": [
        [
          "MODE",
          "local"
        ]
      ],
      "preserve_following_duplicates": false,
      "expected_lines": [
        "MODE=local"
      ],
      "expected_changed": true
    }
  ],
  "dotenv_resolve": {
    "process_env": {
      "PULSESCRIBE_GOLDEN_PROC_VAR": "from-proc"
    },
    "content": "BASE=actual-key\nGROQ_API_KEY=${BASE}\nCHAINED=${GROQ_API_KEY}-suffix\nFROM_PROC=${PULSESCRIBE_GOLDEN_PROC_VAR}\nWITH_DEFAULT=${PULSESCRIBE_GOLDEN_UNSET:-fallback}\nUNSET_PLAIN=${PULSESCRIBE_GOLDEN_UNSET}\nSINGLE_EXP='${BASE}'\nDOUBLE_EXP=\"${BASE}\"\nBARE_DOLLAR=$BASE\n'QUOTED_KEY'=quoted-val\nPULSESCRIBE_APP_CONTEXTS={\"Slack\": \"chat\"}\nJSON_WITH_COMMENT={\"a\": \"b\"} # comment\nUNQUOTED_APOSTROPHE=Bob's Mic # comment\nPULSESCRIBE_INPUT_DEVICE=USB ${PULSESCRIBE_GOLDEN_PROC_VAR}\n",
    "expected": {
      "BARE_DOLLAR": "$BASE",
      "BASE": "actual-key",
      "CHAINED": "actual-key-suffix",
      "DOUBLE_EXP": "actual-key",
      "FROM_PROC": "from-proc",
      "GROQ_API_KEY": "actual-key",
      "JSON_WITH_COMMENT": "{\"a\": \"b\"}",
      "PULSESCRIBE_APP_CONTEXTS": "{\"Slack\": \"chat\"}",
      "PULSESCRIBE_INPUT_DEVICE": "USB ${PULSESCRIBE_GOLDEN_PROC_VAR}",
      "QUOTED_KEY": "quoted-val",
      "SINGLE_EXP": "actual-key",
      "UNQUOTED_APOSTROPHE": "Bob's Mic",
      "UNSET_PLAIN": "",
      "WITH_DEFAULT": "fallback"
    }
  },
