{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseScribe",
  "version": "2.1.0",
  "identifier": "com.kliebhan.pulsescribe",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Fast voice dictation for macOS and Windows",
    "icon": [
      "../../assets/icon.iconset/icon_32x32.png",
      "../../assets/icon.iconset/icon_128x128.png",
      "../../assets/icon.iconset/icon_128x128@2x.png",
      "../../assets/icon.icns",
      "../../assets/icon.ico"
    ],
    "macOS": {
      "infoPlist": "./Info.plist",
      "entitlements": "../../macos/entitlements.plist",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": false,
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "German"],
        "installerHooks": "./nsis/hooks.nsh"
      }
    }
  }
}
